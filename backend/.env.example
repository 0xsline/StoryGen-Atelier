PORT=3005
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3-pro-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Vertex AI fallback (used when Gemini API key is missing/over quota)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_VEO_MODEL=veo-3.1-generate-preview

# MiniMax video generation. Leave VIDEO_PROVIDER empty to use MiniMax when
# MINIMAX_API_KEY is set, or set VIDEO_PROVIDER=minimax explicitly.
VIDEO_PROVIDER=
MINIMAX_API_KEY=
MINIMAX_API_REGION=global_en
MINIMAX_VIDEO_API_HOST=
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_VIDEO_RESOLUTION=2K
MINIMAX_VIDEO_DURATION=
MINIMAX_VIDEO_RATIO=adaptive
MINIMAX_VIDEO_CALLBACK_URL=
