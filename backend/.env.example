PORT=3005
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3-pro-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Vertex AI fallback (used when Gemini API key is missing/over quota)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_VEO_MODEL=veo-3.1-generate-preview

# Image-to-video provider selection: leave empty to auto-detect (MiniMax when
# MINIMAX_API_KEY is set, otherwise Vertex), or set to "minimax"/"vertex".
VIDEO_PROVIDER=
# MiniMax image-to-video (Hailuo) configuration.
MINIMAX_API_KEY=
# Regional OpenAPI root: global_en -> https://api.minimax.io/v1, cn_zh -> https://api.minimaxi.com/v1
MINIMAX_API_REGION=global_en
# Optional explicit host override (takes precedence over MINIMAX_API_REGION).
MINIMAX_API_HOST=
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3
# Optional generation controls.
MINIMAX_VIDEO_DURATION=
MINIMAX_VIDEO_RESOLUTION=
MINIMAX_PROMPT_OPTIMIZER=
MINIMAX_FAST_PRETREATMENT=
