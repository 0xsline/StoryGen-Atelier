PORT=3005

# ── Gemini (default text + image provider) ─────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3-pro-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# ── Vertex AI (Veo video fallback) ─────────────────────────────────────
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_VEO_MODEL=veo-3.1-generate-preview

# ── MiniMax (optional text / image / video providers) ──────────────────
# Shared credentials. Image and video auto-detect MiniMax when this key is set;
# the text path requires LLM_PROVIDER=minimax explicitly.
MINIMAX_API_KEY=
# Regional OpenAPI root: global_en -> https://api.minimax.io, cn_zh -> https://api.minimaxi.com
MINIMAX_API_REGION=global_en

# Text: storyboard generation + transition analysis (MiniMax-M3 by default).
LLM_PROVIDER=
MINIMAX_TEXT_BASE_URL=
MINIMAX_TEXT_MODEL=MiniMax-M3
# Optional thinking control: "disabled" skips M3 reasoning for structured JSON
# output (faster/cheaper); leave empty to use the model default (adaptive).
MINIMAX_TEXT_THINKING=

# Image: storyboard frames (image-01 text-to-image).
IMAGE_PROVIDER=
MINIMAX_IMAGE_API_HOST=
MINIMAX_IMAGE_MODEL=image-01
# "url" or "base64" output format (base64 renders directly in the frontend).
MINIMAX_IMAGE_RESPONSE_FORMAT=base64
# Set to "true" to enable the API-side prompt optimizer.
MINIMAX_PROMPT_OPTIMIZER=

# Video: clip generation on the H3 v2 API (MiniMax-H3 / MiniMax-H3-Max).
VIDEO_PROVIDER=
MINIMAX_VIDEO_API_HOST=
MINIMAX_VIDEO_MODEL=MiniMax-H3
# H3: 768P / 2K. H3-Max: 480P / 768P only.
MINIMAX_VIDEO_RESOLUTION=2K
MINIMAX_VIDEO_DURATION=
MINIMAX_VIDEO_RATIO=adaptive
MINIMAX_VIDEO_CALLBACK_URL=
