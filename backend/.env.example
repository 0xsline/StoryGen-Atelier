PORT=3005
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3-pro-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# MiniMax text generation. Set LLM_PROVIDER=minimax to enable this path.
LLM_PROVIDER=
MINIMAX_API_KEY=
# Regional OpenAPI root: global_en -> https://api.minimax.io/v1, cn_zh -> https://api.minimaxi.com/v1
MINIMAX_API_REGION=global_en
# Optional explicit base URL override (takes precedence over MINIMAX_API_REGION).
MINIMAX_TEXT_BASE_URL=
MINIMAX_TEXT_MODEL=MiniMax-M3
# Optional thinking control: "disabled" skips M3 reasoning for structured JSON
# output (faster/cheaper); leave empty to use the model default (adaptive).
MINIMAX_TEXT_THINKING=

# Vertex AI fallback (used when Gemini API key is missing/over quota)
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_VEO_MODEL=veo-3.1-generate-preview

# Image provider selection: leave empty to auto-detect (MiniMax when
# MINIMAX_API_KEY is set, otherwise Gemini), or set to "minimax"/"gemini".
IMAGE_PROVIDER=
# MiniMax text-to-image (image-01 / image-01-live) configuration.
MINIMAX_API_KEY=
# Regional OpenAPI root: global_en -> https://api.minimax.io/v1, cn_zh -> https://api.minimaxi.com/v1
MINIMAX_API_REGION=global_en
# Optional explicit host override (takes precedence over MINIMAX_API_REGION).
MINIMAX_IMAGE_API_HOST=
MINIMAX_IMAGE_MODEL=image-01
# "url" or "base64" output format (base64 renders directly in the frontend).
MINIMAX_IMAGE_RESPONSE_FORMAT=base64
# Set to "true" to enable the API-side prompt optimizer.
MINIMAX_PROMPT_OPTIMIZER=
